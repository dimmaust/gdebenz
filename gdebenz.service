[Unit]
Description=GdeBenz Fuel Monitor
After=network.target

[Service]
Type=simple
User=gdebenz
Group=gdebenz
WorkingDirectory=/opt/gdebenz
ExecStart=/opt/gdebenz/venv/bin/python monitor.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
